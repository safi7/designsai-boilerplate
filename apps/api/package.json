{
  "name": "@boilerplate/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "yarn run -T eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "openapi:export": "tsx src/scripts/export-openapi.ts",
    "db:seed": "tsx src/seeds/seed.ts",
    "credits:grant": "tsx src/scripts/grant-credits.ts",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@aws-sdk/client-ses": "^3.956.0",
    "@boilerplate/shared-audit": "workspace:*",
    "@boilerplate/shared-cache": "workspace:*",
    "@boilerplate/shared-logger": "workspace:*",
    "@boilerplate/shared-prisma": "workspace:*",
    "@boilerplate/shared-schemas": "workspace:*",
    "@boilerplate/shared-storage": "workspace:*",
    "@boilerplate/shared-utils": "workspace:*",
    "@hono/node-server": "^1.13.1",
    "@hono/swagger-ui": "^0.4.1",
    "@hono/zod-openapi": "0.19.10",
    "bcryptjs": "^3.0.2",
    "dotenv": "^16.4.5",
    "google-auth-library": "^9.15.0",
    "hono": "^4.6.3",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^7.0.6",
    "stripe": "^19.1.0",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^22.9.0",
    "@types/nodemailer": "^7.0.2",
    "@vitest/coverage-v8": "^3.2.4",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
