{
  "name": "@boilerplate/shared-utils",
  "version": "0.1.0",
  "private": true,
  "description": "Error model and localized email templates",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./email-templates": {
      "types": "./dist/email-templates/index.d.ts",
      "import": "./dist/email-templates/index.js"
    }
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "yarn run -T eslint src",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "handlebars": "^4.7.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
