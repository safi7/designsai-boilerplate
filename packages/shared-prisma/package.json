{
  "name": "@boilerplate/shared-prisma",
  "version": "0.1.0",
  "private": true,
  "description": "Prisma schema, migrations and client — the database lives here",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "prisma": {
    "schema": "prisma/schema.prisma"
  },
  "scripts": {
    "build": "prisma generate && tsc",
    "dev": "tsc --watch --preserveWatchOutput",
    "lint": "yarn run -T eslint src",
    "type-check": "prisma generate && tsc --noEmit",
    "test": "vitest run",
    "clean": "rm -rf dist",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:diff": "prisma migrate diff --from-migrations prisma/migrations --to-schema-datamodel prisma/schema.prisma --shadow-database-url \"$SHADOW_DATABASE_URL\" --script",
    "db:reset": "prisma migrate reset --force",
    "db:studio": "prisma studio"
  },
  "dependencies": {
    "@prisma/client": "5.22.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "prisma": "5.22.0",
    "typescript": "^5.6.3",
    "vitest": "^3.2.4"
  }
}
